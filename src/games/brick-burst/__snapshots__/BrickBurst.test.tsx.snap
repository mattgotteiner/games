// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Brick Burst chrome > uses the shared pause chrome, focuses Resume, and restores play focus 1`] = `"<div class="game-overlay-card"><h2 id="brick-pause-heading">Paused</h2><fieldset class="pause-difficulty"><legend><span>Difficulty</span><output>Medium · 1×</output></legend><input type="range" min="0" max="2" step="1" aria-label="Difficulty" aria-valuetext="Medium, 1× speed and score, applies at next serve"><div class="difficulty-ticks" aria-hidden="true"><span class="">Easy</span><span class="selected">Medium</span><span class="">Hard</span></div></fieldset><div class="overlay-actions"><button class="button-primary" type="button" aria-label="Resume game">Resume</button><button class="button-secondary" type="button" aria-label="Restart game">Restart</button><button class="button-secondary pause-help-action" type="button">Help</button></div></div>"`;
